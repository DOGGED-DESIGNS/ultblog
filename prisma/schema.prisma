generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(READER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  twitter       String?
  insta         String?

  accounts  Account[]
  sessions  Session[]
  posts     Post[]    @relation("AuthorPosts")
  comments  Comment[] @relation("UserComments")

  @@map("users")
}

model Post {
  id          String     @id @default(uuid())
  authorId    String
  title       String
  slug        String     @unique
  summary     String?
  content     String     @db.Text
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  thumbnail   String

  // ✅ do NOT cascade — preserve posts if author deleted
  author User @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // ✅ do NOT cascade — keep posts if category deleted
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  tags     PostTag[]
  comments Comment[]  @relation("PostComments")
  views    PostView[]
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String

  // ✅ join table must cascade
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String?
  content   String   @db.Text
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ comments must disappear if post deleted
  post Post @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // ✅ keep comment if user deleted
  author User? @relation("UserComments", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // ✅ delete replies when parent deleted
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replies Comment[] @relation("CommentReplies")
}

model PostView {
  id        String   @id @default(uuid())
  postId    String
  ipAddress String
  device    Device   @default(DESKTOP)
  createdAt DateTime @default(now())

  // ✅ analytics must disappear with post
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Image {
  id        String   @id @default(cuid())
  url       String   @unique
  key       String   @unique
  hash      String   @unique
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // ✅ auth data must disappear with user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  // ✅ session must disappear with user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AUTHOR
  READER
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum Device {
  DESKTOP
  MOBILE
}
